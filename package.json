{
  "name": "dynasty",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:check": "vite-node tools/headless.ts --",
    "sim:check:all": "vite-node tools/scenarios.ts --",
    "sim:seeds": "vite-node tools/seeds.ts --",
    "range": "vite-node tools/range.ts --",
    "world:build": "vite-node tools/worlddata/run.ts",
    "verify": "npm run typecheck && npm run test && npm run sim:check:all && npm run e2e",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/animals.spec.ts e2e/group-colors.spec.ts e2e/dig-animation.spec.ts",
    "shots": "playwright test e2e/screenshots.spec.ts",
    "why": "vite-node tools/why.ts --",
    "profile:systems": "vite-node tools/profile-systems.ts",
    "infants": "vite-node tools/infants.ts --",
    "violence": "vite-node tools/violence.ts --",
    "i18n:soak": "vite-node tools/i18n-soak.ts --",
    "art:build": "vite-node tools/art/build.ts --",
    "art:sheet": "vite-node tools/art/sheet.ts --"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
